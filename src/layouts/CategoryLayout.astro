---
interface Props {
  title: string;
  description: string;
  count: string;
}
const { title, description, count } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — The Wine Bible</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>

    <div class="page">
      <nav class="topbar">
        <a href={`${base}`} class="back-link">
          <span class="back-arrow">←</span>
          <span>The Wine Bible</span>
        </a>
      </nav>

      <header class="page-header">
        <p class="page-count">{count}</p>
        <h1 class="page-title">{title}</h1>
        <p class="page-description">{description}</p>
      </header>

      <div class="page-content">
        <slot />
      </div>
    </div>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  .page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  .topbar {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .back-link:hover { color: var(--accent); }
  .back-arrow { font-size: 1rem; }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 560px;
  }

  .page-count {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .page-description {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-secondary);
    font-weight: 300;
  }

  /* Groups */
  .entry-group {
    margin-bottom: 3rem;
  }

  .group-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.75rem;
  }

  /* Entry cards */
  .entry-card {
    padding: 1.125rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 3px;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
  }

  .entry-card.available {
    cursor: pointer;
  }

  .entry-card.available:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-accent);
    transform: translateY(-1px);
  }

  .entry-card.coming-soon {
    opacity: 0.38;
    cursor: default;
    pointer-events: none;
  }

  .entry-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .entry-meta {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 300;
  }

  .entry-badge {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
  }

  @media (max-width: 600px) {
    .page { padding: 0 1rem 4rem; }
    .entry-grid { grid-template-columns: repeat(2, 1fr); gap: 0.625rem; }
  }
</style>
