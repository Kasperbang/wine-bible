              fill="rgba(100,130,180,0.06)" stroke="rgba(100,130,180,0.2)" stroke-width="1" stroke-dasharray="5 4"/>

        <!-- Soil zone labels -->
        <text x="88" y="48" fill="rgba(201,168,76,0.55)" font-size="9" font-family="Inter, sans-serif" text-anchor="middle" font-weight="600" letter-spacing="1">TORTONIAN SOILS</text>
        <text x="88" y="59" fill="rgba(201,168,76,0.4)" font-size="8.5" font-family="Inter, sans-serif" text-anchor="middle">Elegant · Aromatic · Earlier</text>

        <text x="265" y="50" fill="rgba(100,130,200,0.6)" font-size="9" font-family="Inter, sans-serif" text-anchor="middle" font-weight="600" letter-spacing="1">HELVETIAN SOILS</text>
        <text x="265" y="61" fill="rgba(100,130,200,0.45)" font-size="8.5" font-family="Inter, sans-serif" text-anchor="middle">Austere · Tannic · Age-worthy</text>

        <!-- Verduno (small, north) -->
        <circle cx="95" cy="90" r="5" fill="rgba(201,168,76,0.6)" stroke="rgba(201,168,76,0.9)" stroke-width="1"/>
        <text x="106" y="87" fill="var(--text-muted)" font-size="10.5" font-family="Inter, sans-serif">Verduno</text>

        <!-- La Morra (Tortonian, large) -->
        <circle cx="85" cy="145" r="8" fill="#c9a84c" stroke="#e0c06a" stroke-width="1.5"/>
        <text x="100" y="141" fill="var(--text-primary)" font-size="12" font-family="Inter, sans-serif" font-weight="500">La Morra</text>
        <text x="100" y="154" fill="rgba(201,168,76,0.7)" font-size="9" font-family="Inter, sans-serif">Tortonian · Largest commune</text>

        <!-- Barolo town (transition) -->
        <circle cx="155" cy="185" r="7" fill="#c9a84c" stroke="#e0c06a" stroke-width="1.5"/>
        <text x="168" y="181" fill="var(--text-primary)" font-size="12" font-family="Inter, sans-serif" font-weight="500">Barolo</text>
        <text x="168" y="194" fill="rgba(201,168,76,0.7)" font-size="9" font-family="Inter, sans-serif">Transition soils · Cannubi MGA</text>

        <!-- Castiglione Falletto (Helvetian) -->
        <circle cx="230" cy="135" r="7" fill="#7a90c4" stroke="#9aacda" stroke-width="1.5"/>
