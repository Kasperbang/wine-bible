---
import CategoryLayout from '../../layouts/CategoryLayout.astro';
import { wineWorldData } from '../../data/wine-world.ts';
import { countryMaps } from '../../data/wine-maps.ts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const regionGroups = [
  {
    label: "France",
    entries: [
      { name: "Champagne",  meta: "Pinot Noir · Chardonnay · Pinot Meunier", link: `${base}regions/champagne/` },
      { name: "Burgundy",   meta: "Pinot Noir · Chardonnay",                  link: null },
      { name: "Bordeaux",   meta: "Cabernet Sauvignon · Merlot",              link: null },
      { name: "Rhône",      meta: "Grenache · Syrah · Viognier",              link: null },
      { name: "Loire",      meta: "Sauvignon Blanc · Chenin Blanc",           link: null },
      { name: "Alsace",     meta: "Riesling · Pinot Gris · Gewurztraminer",   link: null },
    ]
  },
  {
    label: "Italy",
    entries: [
      { name: "Piedmont",   meta: "Nebbiolo · Barbera · Dolcetto",            link: null },
      { name: "Tuscany",    meta: "Sangiovese · Cabernet Sauvignon",          link: null },
      { name: "Veneto",     meta: "Corvina · Pinot Grigio · Glera",           link: null },
    ]
  },
  {
    label: "Spain",
    entries: [
      { name: "Rioja",      meta: "Tempranillo · Grenache",                   link: null },
      { name: "Ribera del Duero", meta: "Tempranillo",                        link: null },
      { name: "Priorat",    meta: "Grenache · Carignan",                      link: null },
      { name: "Jerez",      meta: "Palomino · Pedro Ximénez",                 link: null },
    ]
  },
  {
    label: "New World",
    entries: [
      { name: "Napa Valley",      meta: "Cabernet Sauvignon",                link: null },
      { name: "Sonoma County",    meta: "Pinot Noir · Chardonnay",           link: null },
      { name: "Barossa Valley",   meta: "Shiraz · Grenache",                 link: null },
      { name: "Marlborough",      meta: "Sauvignon Blanc",                   link: null },
      { name: "Mendoza",          meta: "Malbec",                            link: null },
      { name: "Stellenbosch",     meta: "Cabernet Sauvignon · Chenin Blanc", link: null },
    ]
  },
];

const mapsJson = JSON.stringify(countryMaps);
const wineDataJson = JSON.stringify(wineWorldData);
---

<CategoryLayout
  title="Wine Regions"
  description="Explore the world's great wine-producing regions — from Champagne's chalk subsoil to Barossa's old-vine Shiraz."
  count={`${Object.keys(wineWorldData).length} countries`}
>

  <!-- ── LEVEL 1: Country flag grid ───────────────────────────── -->
  <section id="country-grid-section">
    <div class="country-grid" id="country-grid">
      {countryMaps.map(c => (
        <button class="country-btn" data-key={c.key}>
          <span class="country-flag">{c.flag}</span>
          <span class="country-name">{c.name}</span>
        </button>
      ))}
    </div>
  </section>

  <!-- ── LEVEL 2: Country SVG map ────────────────────────────── -->
  <section id="map-section" class="hidden">
    <nav class="breadcrumb">
      <button class="bc-btn" id="bc-home">All Regions</button>
      <span class="bc-sep">›</span>
      <span class="bc-current" id="bc-country"></span>
    </nav>
    <div class="map-container">
      <svg id="country-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"></svg>
    </div>
    <p class="map-hint">Click a wine region to explore</p>
  </section>

  <!-- ── LEVEL 3: Region detail panel ─────────────────────────── -->
  <section id="detail-section" class="hidden">
    <nav class="breadcrumb">
      <button class="bc-btn" id="bc-home2">All Regions</button>
      <span class="bc-sep">›</span>
      <button class="bc-btn" id="bc-country2"></button>
      <span class="bc-sep">›</span>
      <span class="bc-current" id="bc-region"></span>
    </nav>
    <div id="detail-panel"></div>
  </section>

  <!-- ── Static region directory ──────────────────────────────── -->
  <section class="region-directory">
    <h2 class="dir-heading">Region Directory</h2>
    {regionGroups.map(group => (
      <div class="entry-group">
        <p class="group-label">{group.label}</p>
        <div class="entry-grid">
          {group.entries.map(e => (
            e.link
              ? <a href={e.link} class="entry-card available">
                  <p class="entry-name">{e.name}</p>
                  <p class="entry-meta">{e.meta}</p>
                  <span class="entry-badge">Explore →</span>
                </a>
              : <div class="entry-card coming-soon">
                  <p class="entry-name">{e.name}</p>
                  <p class="entry-meta">{e.meta}</p>
                </div>
          ))}
        </div>
      </div>
    ))}
  </section>

</CategoryLayout>

<style is:global>
  /* ── Country grid ─────────────────────────────────────── */
  .country-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .country-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, transform 0.15s;
    color: var(--text-primary);
    font-family: inherit;
  }

  .country-btn:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .country-flag {
    font-size: 2.25rem;
    line-height: 1;
  }

  .country-name {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
    text-align: center;
  }

  /* ── Map section ──────────────────────────────────────── */
  .map-container {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.5rem;
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  #country-svg {
    width: 100%;
    max-width: 540px;
    height: auto;
  }

  .map-hint {
    font-size: 0.75rem;
    text-align: center;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 2.5rem;
  }

  .country-outline {
    fill: #2a1f14;
    stroke: #5a4030;
    stroke-width: 1.2;
    fill-rule: evenodd;
  }

  .region-poly {
    fill: var(--accent);
    fill-opacity: 0.12;
    stroke: var(--accent);
    stroke-width: 1.5;
    cursor: pointer;
    transition: fill-opacity 0.15s;
  }

  .region-poly:hover {
    fill-opacity: 0.35;
  }

  .region-label {
    font-size: 9px;
    font-family: Inter, sans-serif;
    fill: var(--accent);
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* ── Breadcrumb ───────────────────────────────────────── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
  }

  .bc-btn {
    background: none;
    border: none;
    padding: 0;
    color: var(--accent);
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .bc-btn:hover { text-decoration: underline; }

  .bc-sep { color: var(--text-muted); }

  .bc-current {
    color: var(--text-secondary);
    font-weight: 300;
  }

  /* ── Detail panel ─────────────────────────────────────── */
  .detail-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .detail-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
  }

  .detail-card.full-width {
    grid-column: 1 / -1;
  }

  .detail-label {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .detail-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .detail-body {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--text-secondary);
    font-weight: 300;
  }

  .grape-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .grape-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: var(--accent-dim);
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
  }

  .wines-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .wine-tag {
    font-size: 0.6875rem;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 0.2rem 0.6rem;
    border-radius: 2px;
    font-weight: 300;
  }

  .subzones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .subzone-card {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.875rem 1rem;
  }

  .subzone-name {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .subzone-grapes {
    font-size: 0.6875rem;
    color: var(--accent);
    letter-spacing: 0.06em;
    margin-bottom: 0.4rem;
  }

  .subzone-char {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-muted);
    font-weight: 300;
  }

  /* ── Region directory ─────────────────────────────────── */
  .region-directory { margin-top: 4rem; }

  .dir-heading {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--text-primary);
    margin-bottom: 2rem;
  }

  /* ── Utility ──────────────────────────────────────────── */
  .hidden { display: none !important; }

  @media (max-width: 600px) {
    .country-grid { grid-template-columns: repeat(3, 1fr); }
    .detail-panel { grid-template-columns: 1fr; }
    .detail-card.full-width { grid-column: 1; }
  }
</style>

<script define:vars={{ mapsJson, wineDataJson }}>
  const maps = JSON.parse(mapsJson);
  const wineData = JSON.parse(wineDataJson);

  const gridSection   = document.getElementById('country-grid-section');
  const mapSection    = document.getElementById('map-section');
  const detailSection = document.getElementById('detail-section');
  const svg           = document.getElementById('country-svg');
  const bcCountry     = document.getElementById('bc-country');
  const bcCountry2    = document.getElementById('bc-country2');
  const bcRegion      = document.getElementById('bc-region');
  const detailPanel   = document.getElementById('detail-panel');

  let activeCountryKey = null;

  // Level 1 → 2
  document.getElementById('country-grid').addEventListener('click', e => {
    const btn = e.target.closest('.country-btn');
    if (!btn) return;
    showCountryMap(btn.dataset.key);
  });

  function showCountryMap(countryKey) {
    activeCountryKey = countryKey;
    const mapData = maps.find(m => m.key === countryKey);
    if (!mapData) return;

    svg.setAttribute('viewBox', mapData.viewBox);
    svg.innerHTML = '';

    const ns = 'http://www.w3.org/2000/svg';

    const outline = document.createElementNS(ns, 'path');
    outline.setAttribute('d', mapData.outline);
    outline.setAttribute('class', 'country-outline');
    svg.appendChild(outline);

    mapData.regions.forEach(r => {
      const g = document.createElementNS(ns, 'g');
      g.dataset.regionKey = r.key;
      g.style.cursor = 'pointer';

      const poly = document.createElementNS(ns, 'path');
      poly.setAttribute('d', r.path);
      poly.setAttribute('class', 'region-poly');

      const text = document.createElementNS(ns, 'text');
      text.setAttribute('x', r.labelX);
      text.setAttribute('y', r.labelY);
      text.setAttribute('class', 'region-label');
      text.textContent = r.label;

      g.appendChild(poly);
      g.appendChild(text);
      g.addEventListener('click', () => showRegionDetail(countryKey, r.key));
      svg.appendChild(g);
    });

    const label = mapData.name;
    bcCountry.textContent = label;
    bcCountry2.textContent = label;

    gridSection.classList.add('hidden');
    detailSection.classList.add('hidden');
    mapSection.classList.remove('hidden');
  }

  // Level 2 → 3
  function showRegionDetail(countryKey, regionKey) {
    const country = wineData[countryKey];
    if (!country) return;
    const region = country.regions[regionKey];
    if (!region) return;

    bcRegion.textContent = region.label;

    const grapeTagsHtml = region.grapes.map(g => `<span class="grape-tag">${g}</span>`).join('');
    const wineTagsHtml  = region.wines.map(w => `<span class="wine-tag">${w}</span>`).join('');

    const subzonesHtml = region.subzones && region.subzones.length
      ? `<div class="detail-card full-width">
          <p class="detail-label">Sub-regions &amp; appellations</p>
          <div class="subzones-grid">
            ${region.subzones.map(sz => `
              <div class="subzone-card">
                <p class="subzone-name">${sz.name}</p>
                <p class="subzone-grapes">${sz.grapes.join(' · ')}</p>
                <p class="subzone-char">${sz.character}</p>
              </div>
            `).join('')}
          </div>
        </div>`
      : '';

    detailPanel.innerHTML = `
      <div class="detail-panel">
        <div class="detail-card full-width">
          <p class="detail-label">Wine Region</p>
          <h2 class="detail-title">${region.label}</h2>
          <p class="detail-body">${region.character}</p>
        </div>
        <div class="detail-card">
          <p class="detail-label">Key Grapes</p>
          <div class="grape-tags">${grapeTagsHtml}</div>
        </div>
        <div class="detail-card">
          <p class="detail-label">Wine Styles</p>
          <div class="wines-list">${wineTagsHtml}</div>
        </div>
        ${subzonesHtml}
      </div>
    `;

    mapSection.classList.add('hidden');
    detailSection.classList.remove('hidden');
  }

  // Breadcrumb nav
  document.getElementById('bc-home').addEventListener('click', () => {
    detailSection.classList.add('hidden');
    mapSection.classList.add('hidden');
    gridSection.classList.remove('hidden');
  });

  document.getElementById('bc-home2').addEventListener('click', () => {
    detailSection.classList.add('hidden');
    mapSection.classList.add('hidden');
    gridSection.classList.remove('hidden');
  });

  document.getElementById('bc-country2').addEventListener('click', () => {
    detailSection.classList.add('hidden');
    mapSection.classList.remove('hidden');
  });
</script>
