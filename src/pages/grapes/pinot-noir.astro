              fill="rgba(150,160,200,0.04)" stroke="rgba(150,160,200,0.2)" stroke-width="1"/>
        <text x="75" y="415" fill="rgba(150,160,200,0.5)" font-size="9" font-family="Inter, sans-serif"
              text-anchor="middle" writing-mode="tb" letter-spacing="2">CÔTE DE BEAUNE</text>

        <!-- Divider line -->
        <line x1="55" y1="280" x2="300" y2="280" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 4"/>

        <!-- Villages — Côte de Nuits (north to south) -->
        <!-- Marsannay -->
        <circle cx="138" cy="48" r="3" fill="var(--text-muted)"/>
        <text x="148" y="52" fill="var(--text-muted)" font-size="11" font-family="Inter, sans-serif">Marsannay</text>

        <!-- Fixin -->
        <circle cx="138" cy="72" r="3" fill="var(--text-muted)"/>
        <text x="148" y="76" fill="var(--text-muted)" font-size="11" font-family="Inter, sans-serif">Fixin</text>

        <!-- Gevrey-Chambertin — Grand Cru -->
        <circle cx="138" cy="104" r="5" fill="#c9a84c"/>
