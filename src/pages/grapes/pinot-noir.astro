        <!-- North indicator -->
        <text x="310" y="30" fill="#5c504a" font-size="11" font-family="Inter, sans-serif" text-anchor="middle" font-weight="600">N</text>
        <polygon points="310,34 307,46 310,43 313,46" fill="#5c504a"/>
        <line x1="310" y1="46" x2="310" y2="54" stroke="#5c504a" stroke-width="1.5" stroke-linecap="round"/>

